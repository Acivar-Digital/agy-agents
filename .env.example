# ==============================================================================
# agy-agents Configuration Template
# ==============================================================================

# --- Option A: Public Community Mode (Direct Google Gemini API) ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Google API base URL (defaults to https://generativelanguage.googleapis.com)
# GOOGLE_NATIVE_BASE_URL=https://generativelanguage.googleapis.com

# --- Option B: Private / Self-Hosted Mode (LiteRouter Gateway) ---
# If you run a local or LAN LiteRouter gateway (https://github.com/gastownhall/literouter)
# LITEROUTER_HOST=literouter.lan
# LITEROUTER_PORT=7766
# LITEROUTER_AUTH_KEY=your_literouter_key_here

# --- General Settings ---
# Agent model or profile name (default: antigravity-preview-09-2026)
AGENT_MODEL=antigravity-preview-09-2026

# Request timeout in seconds (default: 600)
TIMEOUT=600
