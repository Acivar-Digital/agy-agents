# Google Gemini API Configuration (Default for community users)
GEMINI_API_KEY=your_gemini_api_key_here

# LiteRouter Gateway Configuration (Optional for self-hosted / private gateway)
LITEROUTER_HOST=literouter.lan
LITEROUTER_PORT=7766
LITEROUTER_AUTH_KEY=your_literouter_auth_key_here

# Request timeout in seconds for execution
TIMEOUT=1200